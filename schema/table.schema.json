{
  "$id": "table.schema.json",
  "type": "object",
  "required": [
    "id",
    "category",
    "slot",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z-]+$"
    },
    "category": {
      "enum": [
        "character",
        "prop",
        "creature",
        "building",
        "scene",
        "shared"
      ]
    },
    "slot": {
      "type": "string",
      "pattern": "^[a-z-]+$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "surreal": {
            "type": "boolean"
          },
          "tier": {
            "enum": [
              "minor",
              "notable",
              "legendary"
            ]
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "form": {
            "enum": [
              "predicate",
              "clause"
            ]
          },
          "spines": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "stolen",
                "cursed",
                "bargain",
                "betrayed",
                "lost",
                "awakened",
                "guardian",
                "prophecy"
              ]
            }
          },
          "people": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "a",
                "b"
              ]
            }
          }
        }
      }
    }
  }
}
