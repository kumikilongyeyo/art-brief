{
  "$id": "category.schema.json",
  "type": "object",
  "required": ["id", "name", "primarySlot", "baseTags", "slots", "optionalSlots", "dependencies", "dropOrder", "template"],
  "additionalProperties": false,
  "properties": {
    "id": { "enum": ["character", "prop", "creature", "building", "scene"] },
    "name": { "type": "string" },
    "primarySlot": { "type": "string" },
    "baseTags": { "type": "array", "items": { "type": "string" } },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["table", "material", "palette", "unique", "name", "event"] },
          "table": { "type": "string" },
          "actors": { "type": "string" },
          "count": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "optionalSlots": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "dropOrder": { "type": "array", "items": { "type": "string" } },
    "template": { "type": "string" }
  }
}
